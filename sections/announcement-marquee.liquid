<style>
  .marquee-container-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding }}px 0;
    position: relative;
    display: flex;
    white-space: nowrap;
  }
  .marquee-content-{{ section.id }} {
    display: flex;
    flex-shrink: 0;
    min-width: 100%;
    animation: marquee-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }
  .marquee-content-{{ section.id }} span {
    padding: 0 50px;
    font-size: {{ section.settings.font_size }}px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 1px;
  }
  @keyframes marquee-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

<div class="marquee-container-{{ section.id }}">
  {%- assign marquee_text = section.settings.announcement_text -%}
  <div class="marquee-content-{{ section.id }}">
    {%- for i in (1..10) -%}
      <span>{{ marquee_text }}</span>
    {%- endfor -%}
  </div>
  <div class="marquee-content-{{ section.id }}">
    {%- for i in (1..10) -%}
      <span>{{ marquee_text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Marquee",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Welcome to our store! Free shipping on orders over $50."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Announcement Marquee"
    }
  ]
}
{% endschema %}
