{%- style -%}
  .teks-editorial-{{ section.id }} {
    padding: 0;
    margin: 0;
    overflow: hidden;
    background-color: var(--color-neutral-100);
  }

  .teks-editorial__container {
    display: flex;
    flex-wrap: wrap;
    min-height: 70vh;
    align-items: center;
    flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
  }

  .teks-editorial__image-column {
    flex: 1 1 50%;
    height: 70vh;
    overflow: hidden;
  }

  .teks-editorial__image-column img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .teks-editorial-{{ section.id }}:hover .teks-editorial__image-column img {
    transform: scale(1.05);
  }

  .teks-editorial__text-column {
    flex: 1 1 50%;
    padding: 8rem;
    background-color: var(--color-neutral-200);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  @media screen and (max-width: 989px) {
    .teks-editorial__text-column {
      padding: 4rem;
      flex: 1 1 100%;
      min-height: auto;
    }
    .teks-editorial__image-column {
      flex: 1 1 100%;
      height: 40vh;
    }
  }

  .teks-editorial__subtitle {
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 500 !important;
    font-size: 1.2rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.2em !important;
    color: var(--color-neutral-700);
    margin-bottom: 2rem;
    display: block;
    opacity: 0.7;
  }

  .teks-editorial__title {
    font-size: clamp(2.8rem, 4vw, 4.2rem) !important;
    line-height: 1.1 !important;
    margin-bottom: 3rem !important;
    text-transform: uppercase;
  }

  .teks-editorial__description {
    font-size: 1.6rem;
    color: var(--color-neutral-700);
    margin-bottom: 4rem;
    max-width: 45rem;
    line-height: 1.6;
  }

  .teks-editorial__text-column .button {
    align-self: flex-start;
  }

  @media screen and (max-width: 749px) {
    .teks-editorial__container {
      flex-direction: column !important;
    }
  }
{%- endstyle -%}

<section class="teks-editorial-{{ section.id }}">
  <div class="teks-editorial__container">
    <div class="teks-editorial__image-column">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1500 | image_tag:
           class: 'motion-reduce',
           loading: 'lazy',
           widths: '375, 550, 750, 1100, 1500'
        }}
      {%- else -%}
        {%- if section.settings.image_position == 'left' -%}
          <img src="{{ 'teks-hero.png' | asset_url }}" alt="{{ section.settings.title }}" loading="lazy" width="1000" height="800">
        {%- else -%}
          <img src="{{ 'teks-cat-seating.png' | asset_url }}" alt="{{ section.settings.title }}" loading="lazy" width="1000" height="800">
        {%- endif -%}
      {%- endif -%}
    </div>
    
    <div class="teks-editorial__text-column">
      {%- if section.settings.subtitle != blank -%}
        <span class="teks-editorial__subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="teks-editorial__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="teks-editorial__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button primary-button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Teks Teks Editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position on Desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Signature Style"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Modern Luxe Living"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover considered combinations, styled to inspire and designed to elevate every space."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop the Look"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Teks Teks Editorial"
    }
  ]
}
{% endschema %}
